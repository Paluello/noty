<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shows the library in the Files app ("On My iPad › Noty"), see ADR-0005. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Lectures keep recording with the iPad locked (ADR-0010). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
