    },
    "With finger drawing off, only Apple Pencil writes and fingers scroll and zoom. Writing near the bottom of the last page adds a new one.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la scrittura con le dita è disattivata, scrive solo Apple Pencil e con le dita scorri e ingrandisci. Scrivendo in fondo all'ultima pagina ne viene aggiunta una nuova."
          }
        }
      }
    },
    "With finger drawing off, only Apple Pencil writes and fingers scroll and zoom. Writing near the bottom of the last page adds a new one. To draw a perfect line, circle or rectangle, hold the Pencil still at the end of the stroke.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la scrittura con le dita è disattivata, scrive solo Apple Pencil e con le dita scorri e ingrandisci. Scrivendo in fondo all'ultima pagina ne viene aggiunta una nuova. Per una linea, un cerchio o un rettangolo perfetti, tieni ferma la Pencil alla fine del tratto."
          }
        }
      }
    },
